# --- Oh My Zsh Configuration ---
export ZSH="$HOME/.oh-my-zsh"

ZSH_THEME="robbyrussell"

plugins=(
  git
  tmux
  virtualenv
  zsh-autosuggestions
)

# Load Oh My Zsh
source $ZSH/oh-my-zsh.sh

# --- User Configuration ---
export LANG=en_US.UTF-8
export HIST_STAMPS="yyyy-mm-dd"

# Add virtualenv indicator to prompt if applicable
PROMPT='${VIRTUAL_ENV:+(${VIRTUAL_ENV:t})} '$PROMPT

# --- Custom Functions ---

# Lazy-load work function (kept as potentially useful)
autoload -U work

# Create or attach to a tmux session named 'work'
work() {
  tmux new-session -A -s work
}

# Function to copy file content to LOCAL clipboard via OSC 52 escape code
c() {
  # Check if filename is provided
  if [ -z "$1" ]; then
    echo "Usage: c <filename>" >&2
    return 1
  fi

  # Check if base64 is available
  if ! command -v base64 > /dev/null; then
    echo "Error: 'base64' command is required for OSC 52 copying." >&2
    return 1
  fi

  # Check if the file exists and is readable
  if [ ! -r "$1" ]; then
     echo "Error: Cannot read file '$1'" >&2
     return 1
  fi

  # OSC 52 sequence: \e]52;c;$(base64 encoded content)\a
  #   \e]52;  -> Start OSC 52 sequence
  #   c;      -> Target the system clipboard
  #   $(...)  -> Base64 encoded file content
  #   \a      -> Bell character (terminator)
  # Use printf for reliability over echo
  printf '\e]52;c;%s\a' "$(base64 < "$1")"
}

# --- Load Secrets ---
# Load sensitive variables if the file exists
if [ -f "$HOME/.secrets" ]; then
    source "$HOME/.secrets"
fi

# --- Source Ansible managed config ---
ANSIBLE_ZSHRC_FILE="$HOME/.zshrc_ansible"
if [ -f "$ANSIBLE_ZSHRC_FILE" ]; then
  source "$ANSIBLE_ZSHRC_FILE"
fi
